# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Google Gemini API Keys
# You can add multiple keys for rotation (numbered 1-9)
GOOGLE_API_KEY="your_google_api_key_here"
GOOGLE_API_KEY_1="your_second_api_key_here"
GOOGLE_API_KEY_2="your_third_api_key_here"
# Add more keys as needed (GOOGLE_API_KEY_3, GOOGLE_API_KEY_4, etc.)

# Legacy OpenAI (optional, not used in current implementation)
OPENAI_API_KEY="your_openai_api_key_here"

# Server Configuration
PORT=3001
NODE_ENV=development
